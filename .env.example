# Copia este archivo como .env y rellena los valores.
# El archivo .env no se sube a GitHub (está en .gitignore).

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True solo en desarrollo
DJANGO_DEBUG=True

# Dominios permitidos, separados por comas (en producción)
DJANGO_ALLOWED_HOSTS=

# Correo para enviar los códigos de verificación y la recuperación de contraseña.
# Si EMAIL_HOST_PASSWORD está vacío, los correos se muestran en la consola.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Dominio que aparece en los enlaces de recuperación de contraseña
# (en Codespaces: <nombre-del-codespace>-8000.app.github.dev)
PASSWORD_RESET_DOMAIN=localhost:8000
PASSWORD_RESET_PROTOCOL=http
